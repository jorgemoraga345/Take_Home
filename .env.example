# ─── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=1337

# ─── Database (Supabase Postgres) ─────────────────────
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: use the pooled connection string from Supabase Connect.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=10
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres_test

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
ADMIN_REGISTRATION_SECRET_KEY=change-me-too
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password

# ─── CORS ─────────────────────────────────────────────
DEV_ORIGINS=http://localhost:3000,http://localhost:5173
PROD_ORIGINS=https://shop.example.com

# ─── Phase 3 connectors (leave unset until implemented) ─
# EXCHANGE_RATE_API_URL=
# EXCHANGE_RATE_TIMEOUT_MS=3000
# SHIPPING_API_URL=
# PAYMENT_WEBHOOK_SECRET=
